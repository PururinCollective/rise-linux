IPC: reach the gateway of a /32 DHCP lease (L2TP, SSTP, OpenVPN TUN)

RISE Linux gives VPN clients a /32 lease (netmask 255.255.255.255) with the
classless routes "gateway/32 on-link" and "0.0.0.0/0 via gateway" (DHCP
options 121/249). The in-process client (IPC) that bridges the L3 protocols
onto the hub got both wrong:

- a route with gateway 0.0.0.0 (on-link) made 0.0.0.0 the next hop, and the
  packet was dropped, so the gateway itself was unreachable;
- ARP answers from outside the subnet were never learned, and with a /32
  subnet that is every address, the gateway included.

IPCIsOnLink4() treats as on-link the subnet, the default gateway, the
gateways of the classless routes and the destinations of on-link routes.
Ethernet clients (SoftEther protocol, OpenVPN TAP) are not affected.

diff -ru a/src/Cedar/IPC.c b/src/Cedar/IPC.c
--- a/src/Cedar/IPC.c
+++ b/src/Cedar/IPC.c
@@ -1282,6 +1282,43 @@
 	}
 }
 
+// Whether an IPv4 address is directly reachable (on-link). Besides the subnet,
+// this is the default gateway and the gateways and on-link (0.0.0.0) routes
+// of the classless route table: with a /32 lease (netmask 255.255.255.255)
+// the gateway lies outside the subnet and is reached through such routes.
+bool IPCIsOnLink4(IPC *ipc, IP *ip)
+{
+	UINT i;
+	DHCP_CLASSLESS_ROUTE *r;
+	// Validate arguments
+	if (ipc == NULL || ip == NULL)
+	{
+		return false;
+	}
+	if (IsInSameNetwork4(ip, &ipc->ClientIPAddress, &ipc->SubnetMask))
+	{
+		return true;
+	}
+	if (IsZeroIP(&ipc->DefaultGateway) == false && CmpIpAddr(&ipc->DefaultGateway, ip) == 0)
+	{
+		return true;
+	}
+	if (ipc->ClasslessRoute.NumExistingRoutes == 0)
+	{
+		return false;
+	}
+	for (i = 0; i < MAX_DHCP_CLASSLESS_ROUTE_ENTRIES; i++)
+	{
+		r = &ipc->ClasslessRoute.Entries[i];
+		if (r->Exists && IsZeroIP(&r->Gateway) == false && CmpIpAddr(&r->Gateway, ip) == 0)
+		{
+			return true;
+		}
+	}
+	r = GetBestClasslessRoute(&ipc->ClasslessRoute, ip);
+	return (r != NULL && IsZeroIP(&r->Gateway));
+}
+
 // Associate the MAC address and IP address on the ARP table
 void IPCAssociateOnArpTable(IPC *ipc, IP *ip, UCHAR *mac_address)
 {
@@ -1295,7 +1332,7 @@
 	{
 		return;
 	}
-	if (IsInSameNetwork4(ip, &ipc->ClientIPAddress, &ipc->SubnetMask) == false)
+	if (IPCIsOnLink4(ipc, ip) == false)
 	{
 		// Not to learn the IP address of outside the subnet
 		return;
@@ -1764,6 +1801,11 @@
 		{
 			Copy(&ip_dst_local, &ipc->DefaultGateway, sizeof(IP));
 		}
+		else if (IsZeroIP(&r->Gateway))
+		{
+			// An on-link route (gateway 0.0.0.0): the destination itself is the next hop
+			Copy(&ip_dst_local, &ip_dst, sizeof(IP));
+		}
 		else
 		{
 			Copy(&ip_dst_local, &r->Gateway, sizeof(IP));
