[Unit]
Description=RISE Linux installer
After=rise-splash.service systemd-user-sessions.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service
Before=getty.target
ConditionKernelCommandLine=rise.installer

[Service]
Type=idle
ExecStart=/usr/lib/rise/installer
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Environment=TERM=linux
Restart=on-failure

[Install]
WantedBy=multi-user.target
