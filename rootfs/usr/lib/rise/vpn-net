#!/bin/bash
# vpn-net up -- configures SoftEther's TAP interface (tap_<VPN_TAP>) when it
# appears: the gateway addresses, the MTU, proxy-ARP for /32 clients. udev
# starts rise-vpn-net.service for it, so a restart of the VPN server, which
# makes a new TAP device, is configured again by itself.
. /usr/lib/rise/common.sh

up() {
	local i
	for i in $(seq 1 30); do
		[ -e "/sys/class/net/$TAP_IF" ] && break
		sleep 1
	done
	[ -e "/sys/class/net/$TAP_IF" ] || die "$TAP_IF did not appear"

	# routing: the global switches (also in /etc/sysctl.d/90-rise.conf)
	sysctl -qw net.ipv4.ip_forward=1
	sysctl -qw net.ipv4.conf.all.send_redirects=0
	is_on "$VPN_IPV6_ENABLE" && sysctl -qw net.ipv6.conf.all.forwarding=1

	local c=net.ipv4.conf.$TAP_IF
	# /32 clients ARP for everything; this server answers, on the same
	# interface (pvlan), so client-to-client traffic is routed through here
	local parp=0
	is_on "$VPN_PROXY_ARP" && parp=1
	sysctl -qw "$c.proxy_arp=$parp" "$c.proxy_arp_pvlan=$parp" \
		"$c.send_redirects=0" "$c.accept_redirects=0" "$c.rp_filter=1"

	ip link set dev "$TAP_IF" mtu "$VPN_MTU" up
	ip -4 addr flush dev "$TAP_IF" scope global
	ip -4 addr add "$VPN_IPV4" dev "$TAP_IF"

	if is_on "$VPN_IPV6_ENABLE"; then
		local c6=net.ipv6.conf.$TAP_IF
		sysctl -qw "$c6.disable_ipv6=0" "$c6.accept_ra=0" "$c6.autoconf=0" \
			"$c6.accept_redirects=0" "$c6.mtu=$VPN_MTU"
		ip -6 addr flush dev "$TAP_IF" scope global
		ip -6 addr add "$VPN_IPV6" dev "$TAP_IF" nodad
	else
		sysctl -qw "net.ipv6.conf.$TAP_IF.disable_ipv6=1"
	fi
	log "$TAP_IF up: $VPN_IPV4${VPN_IPV6_ENABLE:+ $VPN_IPV6} mtu $VPN_MTU"

	# DHCP and router advertisements follow the new interface
	systemctl try-restart rise-dnsmasq.service >/dev/null 2>&1 || true
}

case "${1:-up}" in
up) up ;;
down) ip link set dev "$TAP_IF" down 2>/dev/null || true ;;
*) echo "usage: $0 up|down" >&2; exit 2 ;;
esac
