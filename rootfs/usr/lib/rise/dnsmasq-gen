#!/bin/bash
# dnsmasq-gen -- writes /run/rise/dnsmasq.conf and /run/rise/dhcp-hosts from
# rise.conf and /etc/rise/dhcp-static.conf. dnsmasq serves DHCPv4, DHCPv6 and
# router advertisements on the VPN side only; it answers no DNS (port=0).
#
# /32 clients (VPN_PROXY_ARP): netmask 255.255.255.255, and classless routes
# (options 121 and 249) that put the gateway on-link and route everything
# else to it. The IPv6 prefix is advertised off-link (no L bit): every packet
# goes to the router, as with IPv4.
#
# dhcp-static.conf: "mac ipv4 ipv6 hostname", "-" for an empty field.
. /usr/lib/rise/common.sh

CONF=$RISE_RUN/dnsmasq.conf
HOSTS=$RISE_RUN/dhcp-hosts

gw=$(ipq addr "$VPN_IPV4")
mask=$(ipq netmask "$VPN_IPV4")

{
	echo "# generated by /usr/lib/rise/dnsmasq-gen from /etc/rise/rise.conf"
	echo "port=0"
	echo "interface=$TAP_IF"
	echo "bind-dynamic"
	echo "except-interface=lo"
	echo "dhcp-authoritative"
	echo "dhcp-leasefile=$RISE_STATE/dnsmasq.leases"
	echo "dhcp-hostsfile=$HOSTS"
	echo "pid-file=$RISE_RUN/dnsmasq.pid"
	echo "log-facility=-"
	echo "quiet-dhcp"
	echo "quiet-dhcp6"
	echo "quiet-ra"

	echo "dhcp-range=set:vpn4,$VPN_DHCP_START,$VPN_DHCP_END,$mask,$VPN_DHCP_LEASE"
	echo "dhcp-option=tag:vpn4,option:router,$gw"
	[ -n "$VPN_DNS4" ] && echo "dhcp-option=tag:vpn4,option:dns-server,$(echo $VPN_DNS4 | tr ' ' ',')"
	echo "dhcp-option=tag:vpn4,option:mtu,$VPN_MTU"
	if is_on "$VPN_PROXY_ARP"; then
		echo "dhcp-option=tag:vpn4,option:netmask,255.255.255.255"
		echo "dhcp-option=tag:vpn4,121,$gw/32,0.0.0.0,0.0.0.0/0,$gw"
		echo "dhcp-option=tag:vpn4,249,$gw/32,0.0.0.0,0.0.0.0/0,$gw"
	fi

	if is_on "$VPN_IPV6_ENABLE"; then
		first=$(ipq first "$VPN_IPV6")
		last=$(ipq last "$VPN_IPV6")
		plen=$(ipq prefix "$VPN_IPV6")
		mode=slaac
		is_on "$VPN_PROXY_ARP" && mode="slaac,off-link"
		echo "enable-ra"
		echo "ra-param=$TAP_IF,mtu:$VPN_MTU,high,60,1800"
		echo "dhcp-range=set:vpn6,$first,$last,$mode,$plen,$VPN_DHCP_LEASE"
		if [ -n "$VPN_DNS6" ]; then
			d=; for a in $VPN_DNS6; do d="$d,[$a]"; done
			echo "dhcp-option=tag:vpn6,option6:dns-server${d}"
		fi
	fi
} > "$CONF.tmp"
mv "$CONF.tmp" "$CONF"

# static leases
{
	[ -r "$RISE_DHCP_STATIC" ] && awk '
		/^[[:space:]]*(#|$)/ { next }
		{
			line = $1
			if ($2 != "" && $2 != "-") line = line "," $2
			if ($3 != "" && $3 != "-") line = line ",[" $3 "]"
			if ($4 != "" && $4 != "-") line = line "," $4
			print line
		}' "$RISE_DHCP_STATIC"
} > "$HOSTS.tmp"
mv "$HOSTS.tmp" "$HOSTS"
